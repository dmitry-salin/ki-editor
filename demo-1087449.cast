[214.707763, "o", "\u001b[?25l\u001b[1;30H\u001b[21m\u001b[59m\u001b[24m\u001b[48;2;255;255;255m\u001b[38;2;44;44;44m \u001b[29Gs\u001b[28Gr\u001b[27G.\u001b[26Gi\u001b[25Gl\u001b[24Gc\u001b[23G \u001b[22G \u001b[21G🦀\u001b[20G \u001b[19G]\u001b[18G-\u001b[17G[\u001b[16G \u001b[15G\u001b[48;2;44;44;44m\u001b[38;2;255;255;255m \u001b[14Gs\u001b[13Gr\u001b[12G.\u001b[11Gp\u001b[10Gp\u001b[9Ga\u001b[8G \u001b[7G \u001b[6G🦀\u001b[5G \u001b[4G]\u001b[3G-\u001b[2G[\u001b[1G \u001b[2;49H\u001b[48;2;255;255;255m\u001b[38;2;51;51;51m;\u001b[48G\u001b[38;2;0;16;128mr\u001b[47Ge\u001b[46Gt\u001b[45Gn\u001b[44Gi\u001b[43Gr\u001b[42Gp\u001b[41G_\u001b[40Gp\u001b[39Ga\u001b[38Gm\u001b[37Gy\u001b[36Ge\u001b[35Gk\u001b[34G_\u001b[33Gr\u001b[32Go\u001b[31Gt\u001b[30Gi\u001b[29Gd\u001b[28Ge\u001b[27G\u001b[38;2;51;51;51m:\u001b[26G:\u001b[25Gs\u001b[24Gt\u001b[23Gn\u001b[22Ge\u001b[21Gn\u001b[20Go\u001b[19Gp\u001b[18Gm\u001b[17Go\u001b[16Gc\u001b[15G:\u001b[14G:\u001b[13Ge\u001b[12Gt\u001b[11Ga\u001b[10Gr\u001b[9Gc\u001b[8G \u001b[7G\u001b[38;2;175;0;219me\u001b[6Gs\u001b[5Gu\u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m1\u001b[2G \u001b[3;94H\u001b[38;2;51;51;51m \u001b[93G \u001b[92G \u001b[91G \u001b[90G \u001b[89G \u001b[88G \u001b[87G \u001b[86G \u001b[85G \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G;\u001b[20G\u