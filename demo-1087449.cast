[247.484769, "o", "\u001b[58G'\u001b[57G \u001b[56G,\u001b[55G'\u001b[54Gt\u001b[53G'\u001b[52G \u001b[51G,\u001b[50G'\u001b[49Gh\u001b[48G'\u001b[46G,\u001b[45G'\u001b[44Gd\u001b[43G'\u001b[42G \u001b[41G,\u001b[40G'\u001b[39Gu\u001b[38G'\u001b[37G \u001b[36G,\u001b[35G'\u001b[34Gi\u001b[33G'\u001b[32G \u001b[31G,\u001b[30G'\u001b[29Ge\u001b[28G'\u001b[27G \u001b[26G,\u001b[25G'\u001b[24Go\u001b[23G'\u001b[22G \u001b[21G,\u001b[20G'\u001b[19Ga\u001b[18G'\u001b[17G[\u001b[5G \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m5\u001b[2G8\u001b[1G \u001b[11;67H\u001b[38;2;51;51;51m,\u001b[66G]\u001b[65G'\u001b[64Gz\u001b[63G'\u001b[62G \u001b[61G,\u001b[60G'\u001b[59Gv\u001b[58G'\u001b[57G \u001b[56G,\u001b[55G'\u001b[54Gw\u001b[53G'\u001b[52G \u001b[51G,\u001b[50G'\u001b[49Gm\u001b[48G'\u001b[47G \u001b[46G,\u001b[45G'\u001b[44Gb\u001b[43G'\u001b[42G \u001b[41G,\u001b[40G'\u001b[39Gx\u001b[38G'\u001b[37G \u001b[36G,\u001b[35G'\u001b[34Gk\u001b[33G'\u001b[32G \u001b[31G,\u001b[30G'\u001b[29Gj\u001b[28G'\u001b[27G \u001b[26G,\u001b[25G'\u001b[24Gq\u001b[23G'\u001b[22G \u001b[21G,\u001b[20G'\u001b[19G;\u001b[18G'\u001b[17G[\u001b[5G \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m6\u001b[2G8\u001b[1G \u001b[12;64H\u001b[38;2;51;51;51m \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[14G,\u001b[13G]\u001b[5G \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m7\u001b[2G8\u001b[1G \u001b[13;18H\u001b[38;2;51;51;51m \u001b[10G,\u001b[9G)\u001b[5G \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m8\u