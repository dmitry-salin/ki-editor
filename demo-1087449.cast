[50.614861, "o", " \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[15G,\u001b[14G)\u001b[4G\u001b[38;2;106;153;85m4\u001b[3G8\u001b[2G \u001b[1G \u001b[20;18H\u001b[38;2;51;51;51m \u001b[11G;\u001b[10G]\u001b[4G\u001b[38;2;106;153;85m5\u001b[3G8\u001b[2G \u001b[1G \u001b[21;29H\u001b[38;2;51;51;51m \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G(\u001b[20Gw\u001b[19Ge\u001b[18Gn\u001b[17G:\u001b[16G:\u001b[15Gp\u001b[14Ga\u001b[13Gm\u001b[12Gy\u001b[11Ge\u001b[10GK\u001b[4G\u001b[38;2;106;153;85m6\u001b[3G8\u001b[2G \u001b[1G \u001b[22;70H\u001b[38;2;51;51;51m \u001b[68G \u001b[67G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G)\u001b[27G(\u001b[26Gr\u001b[25Ge\u001b[24Gt\u001b[23Gi\u001b[22G_\u001b[21Go\u001b[20Gt\u001b[19Gn\u001b[18Gi\u001b[17G.\u001b[16G]\u001b[15G[\u001b[14G&\u001b[4G\u001b[38;2;106;153;85m7\u001b[3G8\u001b[2G \u001b[1G \u001b[23;59H\u001b[38;2;51;51;51m)\u001b[58Gs\u001b[57Gg\u001b[56Gn\u001b[55Gi\u001b[54Gd\u001b[53Gn\u001b[52Gi\u001b[51Gb\u001b[50Gy\u001b[49Ge\u001b[48Gk\u001b[47G_\u001b[46Ge\u001b[45Gd\u001b[44Go\u001b[43Gm\u001b[42G_\u001b[41Gn\u001b[40Go\u001b[39Gi\u001b[38Gt\u001b[37Gc\u001b[36Ge\u001b[35Gl\u001b[34Ge\u001b[33Gs\u001b[32G_\u001b[31Gy\u001b[30Gr\u001b[29Ga\u001b[28Gm\u001b[27Gi\u001b[26Gr\u001b[25Gp\u001