[212.931523, "o", "\u001b[95G \u001b[94G \u001b[93G \u001b[92G \u001b[91G \u001b[90G \u001b[89G \u001b[88G \u001b[87G \u001b[86G \u001b[85G \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G)\u001b[21G(\u001b[20G\u001b[38;2;121;94;38mr\u001b[19Ge\u001b[18Gt\u001b[17Gi\u001b[16G\u001b[38;2;51;51;51m.\u001b[15G \u001b[14G \u001b[13G \u001b[4G \u001b[3G\u001b[38;2;170;170;170m│\u001b[2G\u001b[38;2;106;153;85m4\u001b[1G2\u001b[26;66H\u001b[38;2;51;51;51m)\u001b[65G\u001b[38;2;0;16;128mt\u001b[64Gn\u001b[63Ge\u001b[62Gv\u001b[61Ge\u001b[60G_\u001b[59Gd\u001b[58Ge\u001b[57Gt\u001b[56Ga\u001b[55Gl\u001b[54Gs\u001b[53Gn\u001b[52Ga\u001b[51Gr\u001b[50Gt\u001b[49G\u001b[38;2;51;51;51m&\u001b[47G=\u001b[46G=\u001b[44G)\u001b[43G(\u001b[42G\u001b[38;2;121;94;38mt\u001b[41Gn\u001b[40Ge\u001b[39Gv\u001b[38Ge\u001b[37G\u001b[38;2;51;51;51m.\u001b[36G\u001b[38;2;0;16;128mp\u001b[35Ga\u001b[34Gm\u001b[33Gy\u001b[32Ge\u001b[31Gk\u001b[29G\u001b[38;2;51;51;51m|\u001b[28G\u001b[38;2;0;16;128mp\u001b[27Ga\u001b[26Gm\u001b[25Gy\u001b[24Ge\u001b[23Gk\u001b[22G\u001b[38;2;51;51;51m|\u001b[21G(\u001b[20G\u001b[38;2;121;94;38md\u001b[19Gn\u001b[18Gi\u001b[17Gf\u001b[16G\u001b[38;2;51;51;51m.\u001b[13G \u001b[4G \u001b[3G\u001b[38;2;170;170;170m│\u001b[2G\u001b[38;2;106;153;85m5\u001b[1G2\u001b[27;67H\u001b[38;2;51;51;51m \u001b[66G \u001b[65G \u001b[64G \u001b[6