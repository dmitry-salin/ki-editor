[244.501774, "o", "\u001b[87G \u001b[86G \u001b[85G \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G{\u001b[37G \u001b[36G\u001b[38;2;38;127;153mt\u001b[35Gp\u001b[34Gm\u001b[33Go\u001b[32Gr\u001b[31GP\u001b[30Gh\u001b[29Gc\u001b[28Gr\u001b[27Ga\u001b[26Ge\u001b[25GS\u001b[24Gn\u001b[23Ge\u001b[22Gp\u001b[21GO\u001b[20G\u001b[38;2;51;51;51m(\u001b[19G\u001b[38;2;121;94;38mp\u001b[18Gp\u001b[17GA\u001b[16G\u001b[38;2;51;51;51m \u001b[15G \u001b[14G \u001b[13G \u001b[3G\u001b[38;2;106;153;85m9\u001b[2G4\u001b[1G7\u001b[8;41H\u001b[38;2;51;51;51m,\u001b[40Gl\u001b[39Ga\u001b[38Gb\u001b[37Go\u001b[36Gl\u001b[35GG\u001b[34G:\u001b[33G:\u001b[32G\u001b[38;2;38;127;153me\u001b[31Gp\u001b[30Go\u001b[29Gc\u001b[28GS\u001b[26G\u001b[38;2;51;51;51m:\u001b[25G\u001b[38;2;0;16;128me\u001b[24Gp\u001b[23Go\u001b[22Gc\u001b[21Gs\u001b[13G\u001b[38;2;51;51;51m \u001b[3G\u001b[38;2;106;153;85m0\u001b[2G5\u001b[1G7\u001b[9;73H\u001b[38;2;51;51;51m,\u001b[72Gd\u001b[71Gr\u001b[70Ga\u001b[69Gw\u001b[68Gr\u001b[67Go\u001b[66GF\u001b[65Gk\u001b[64Go\u001b[63Go\u001b[62GL\u001b[61G:\u001b[60G:\u001b[59G\u001b[38;2;38;127;153md\u001b[58Gn\u001b[57Gu\u001b[56Go\u001b[55GF\u001b[54Gt\u001b[53Go\u001b[52GN\u001b[51Gt\u001b[50Gn\u001b[49Ge\u001b[48Gr\u001b[47Gr\u001b[46Gu\u001b[45GC\u001b[44Gf\u001b[43GI\u001b[42G\u001b[38;2;51;51;51m \u001b[41G:\u001b[40G\u001b[38;2;0;16;128md\u001b[39Gn\u001b[38Gu\u001b[37Go\u001b[36Gf\u001b[35G_\u001b[34Gt\u001b[33Go\u001b[32Gn\u001b[31G_\u001b[30Gt\u001b[29Gn\u001b[28Ge\u001b[27Gr\u001b[26Gr\u001b[