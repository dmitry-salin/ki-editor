u001b[16G \u001b[15Gr\u001b[14Ge\u001b[13Gf\u001b[12Ge\u001b[11GR\u001b[10G \u001b[9G/\u001b[8G/\u001b[7G \u001b[6G \u001b[5G \u001b[4G \u001b[45;30H\u001b[48;2;255;255;255m \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[23G \u001b[18G \u001b[17G \u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[12G \u001b[11G \u001b[9G\u001b[48;2;252;236;234m \u001b[8G[\u001b[7G \u001b[6G \u001b[5G \u001b[4G \u001b[46;63H \u001b[62G,\u001b[61G]\u001b[60G'\u001b[59G;\u001b[58G'\u001b[57G \u001b[56G,\u001b[55G'\u001b[54Gy\u001b[53G'\u001b[52G \u001b[51G,\u001b[50G'\u001b[49Gu\u001b[48G'\u001b[47G \u001b[46G,\u001b[45G'\u001b[44Gl\u001b[43G'\u001b[42G \u001b[41G,\u001b[40G'\u001b[39Gj\u001b[38G'\u001b[37G \u001b[36G,\u001b[35G'\u001b[34Gb\u001b[33G'\u001b[32G \u001b[31G,\u001b[30G'\u001b[29Gp\u001b[28G'\u001b[27G \u001b[26G,\u001b[25G'\u001b[24Gf\u001b[23G'\u001b[22G \u001b[21G,\u001b[20G'\u001b[19Gw\u001b[18G'\u001b[17G \u001b[16G,\u001b[15G'\u001b[14Gq\u001b[13G'\u001b[12G[\u001b[11G \u001b[10G \u001b[9G \u001b[8G \u001b[7G \u001b[6G \u001b[5G \u001b[4G \u001b[3G\u001b[48;2;255;255;255m\u001b[38;2;170;170;170m│\u001b[2G\u001b[38;2;106;153;85m2\u001b[1G1\u001b[47;63H\u001b[48;2;252;236;234m\u001b[38;2;51;51;51m \u001b[62G,\u001b[61G]\u001b[60G'\u001b[59Go\u001b[58G'\u001b[57G \u001b[56G,\u001b[55G'\u001b[54Gi\u001b[53G'\u001b[52G \u001b[51G,\u001b[50G'\u001b[49Ge\u001b[48G'\u001b[47G \u001b[46G,\u001b[45G'\u001b[44Gn\u001b[43G'\u001b[42G \u001b[41G,\u001b[40G'\u001b[39Gm\u001b[38G'\u001b[37G \u001b[36G,\u001b[35G'\u001b[34Gg\u001b[33G'\u001b[32G \u001b[31G,\u001b[30G'\u001b[29Gt\u001b[28G'\u001b[27G \u001b[26G,\u001b[25G'\u001b[24Gs\u001b[23G'\u001b[22G \u001b[21G,\u001b[20G'\u001b[19Gr\u001b[18G'\u001b[17G \u001b[16G,\u001b[15G'\u001b[14Ga\u001b[13G'\u001b[12G[\u001b[11G \u001b[10G \u001b[9G \u001b[8G \u001b[7G \u001b[6G \u001b[5G \u001b[4G \u001b[3G\u001b[48;2;255;255;255m\u001b[38;2;170;170;170m│\u001b[2G\u001b[38;2;106;153;85m3\u001b[1G1\u001b[48;63H\u001b[48;2;25