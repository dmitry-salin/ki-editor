[253.752113, "o", "\u001b[86G \u001b[85G \u001b[84G \u001b[83G \u001b[82G \u001b[81G\u001b[48;2;252;236;234m \u001b[80G,\u001b[79G\"\u001b[78GK\u001b[77GA\u001b[76GM\u001b[75GE\u001b[74GL\u001b[73GO\u001b[72GC\u001b[71G\"\u001b[70G \u001b[69G \u001b[68G \u001b[67G\u001b[38;2;255;255;255m \u001b[66G\u001b[48;2;255;255;255m\u001b[38;2;170;170;170m│\u001b[65G\u001b[38;2;106;153;85m1\u001b[64G \u001b[36;85H\u001b[38;2;51;51;51m \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G\u001b[48;2;252;236;234m \u001b[71G[\u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G\u001b[48;2;255;255;255m\u001b[38;2;170;170;170m│\u001b[65G\u001b[38;2;106;153;85m2\u001b[64G \u001b[37;117H\u001b[48;2;252;236;234m\u001b[38;2;51;51;51my\u001b[116G'\u001b[115G \u001b[114G,\u001b[113G'\u001b[112Gu\u001b[111G'\u001b[110G \u001b[109G,\u001b[108G'\u001b[107Gl\u001b[106G'\u001b[105G \u001b[104G,\u001b[103G'\u001b[102Gj\u001b[101G'\u001b[100G \u001b[99G,\u001b[98G'\u001b[97Gb\u001b[96G'\u001b[95G \u001b[94G,\u001b[93G'\u001b[92Gp\u001b[91G'\u001b[90G \u001b[89G,\u001b[88G'\u001b[87Gf\u001b[86G'\u001b[85G \u001b[84G,\u001b[83G'\u001b[82Gw\u001b[81G'\u001b[80G \u001b[79G,\u001b[78G'\u001b[77Gq\u001b[76G'\u001b[75G[\u001b[74G \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G\u001b[48;2;255;255;255m\u001b[38;2;170;170;170m│\u001b[65G\u001b[38;2;106;153;85m3\u001b[64G \u001b[38;85H\u001b[38;2;51;51;51m \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G\u001b[48;2;252;236;234m \u001b[74G,\u001b[73G]\u001b[72G'\u001b[71G;\u001b[70G'\u001b[69G \u001b[68G,\u001b[67G'\u001b[66G\u001b[48;2;255;255;255m\u001b[38;2;170;170;170m│\u001b[65G\u001b[38;2;106;153;85m↪\u001b[64G \u001b[39;122H\u001b[48;2;252;236;234m\u001b[38;2;51;51;51mo\u001b[121G'\u001b[120G \u001b[119G,\u001b[118G'\u001b[117Gi\u001b[116G'\u001b[115G \u001b[114