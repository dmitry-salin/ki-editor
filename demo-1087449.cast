[172.518267, "o", "\u001b[?25l\u001b[1;124H\u001b[21m\u001b[59m\u001b[24m\u001b[48;2;44;44;44m\u001b[38;2;255;255;255m \u001b[123G \u001b[122G \u001b[121G \u001b[120G \u001b[119G \u001b[118G \u001b[117G \u001b[116G \u001b[115G \u001b[114G \u001b[113G \u001b[112G \u001b[111G \u001b[110G \u001b[109G \u001b[108G \u001b[107G \u001b[106G \u001b[105G \u001b[104G \u001b[103G \u001b[102G \u001b[101G \u001b[100G \u001b[99G \u001b[98G \u001b[97G \u001b[96G \u001b[95G \u001b[94G \u001b[93G \u001b[92G \u001b[91G \u001b[90G \u001b[89G \u001b[88G \u001b[87G \u001b[86G \u001b[85G \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G\u001b[48;2;255;255;255m\u001b[38;2;44;44;44m \u001b[54Gs\u001b[53Gr\u001b[52G.\u001b[51Gp\u001b[50Ga\u001b[49Gm\u001b[48Gy\u001b[47Ge\u001b[46Gk\u001b[45G_\u001b[44Gr\u001b[43Go\u001b[42Gt\u001b[41Gi\u001b[40Gd\u001b[39Ge\u001b[38G \u001b[37G \u001b[36G🦀\u001b[35G \u001b[34G]\u001b[33G \u001b[32G[\u001b[31G \u001b[30G\u001b[48;2;44;44;44m\u001b[38;2;255;255;255m \u001b[29Gs\u001b[28Gr\u001b[27G.\u001b[26Gi\u001b[25Gl\u001b[24Gc\u001b[23G \u001b[22G \u001b[21G🦀\u001b[20G \u001b[19G]\u001b[18G-\u001b[17G[\u001b[16G \u001b[15G \u001b[14Gs\u001b[13Gr\u001b[12G.\u001b[11Gp\u001b[10Gp\u001b[9Ga\u001b[8G \u001b[7G \u001b[6G🦀\u001b[5G \u001b[4G]\u001b[3G-\u001b[2G[\u001b[1G \u001b[2;34H\u001b[48;2;128;128;128m;\u001b[33G\u001b[48;2;173;214;255m\u001b[38;2;51;51;51mp\u001b[32Ga\u001b[31GM\u001b[30Gh\u001b[29Gs\u001b[28Ga\u001b[27GH\u001b[26G:\u001b[25G:\u001b[24Gs\u001b[23Gn\u001b[22Go\u001b[21Gi\u001b[20Gt\u001b[19Gc\u001b[18Ge\u001b[17Gl\u001b[16Gl\u001b[15Go\u001b[14Gc\u001b[13G:\u001b[12G:\u001b[11Gd\u001b[10Gt\u001b[9Gs\u001b[8G \u001b[7Ge\u001b[6Gs\u001b[5Gu\u001b[4G\u001b[48;2;255;255;255m\u001b[38;2;170;170;170m│\u001b[3G\u001b[48;2;199;230;255m\u001b[38;2;106;153;85m1\u001b[2G \u001b[1G \u001b[3;18H\u001b[48;2;255;255;255m\u001b[38;2;51;51;51m \u001b[17G \u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[9G \u001b[7G \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m2\u001b[2G \u001b[1G \u001b[4;34H\u001b[38;2;51;51;51m;\u001b[33Ge\u001b[32Gd\u001b[31Go\u001b[30GC\u001b[29Gy\u001b[28Ge\u001b[27GK\u001b[26G:\u001b[25G:\u001b[24Gt\u001b[23Gn\u001b[22Ge\u001b[21Gv\u001b[20Ge\u001b[19G:\u001b[18G:\u001b[17Gm\u001b[16Gr\u001b[15Ge\u001b[14Gt\u001b[13Gs\u001b[12Gs\u001b[11Go\u001b[10Gr\u001b[9Gc\u001b[7Ge\u001b[6Gs\u001b[5Gu\u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m3\u001b[2G \u001b[1G \u001b[5;24H\u001b[38;2;51;51;51m;\u001b[23Gt\u001b[22Gn\u001b[21Ge\u001b[20Gv\u001b[19GE\u001b[18Gy\u001b[17Ge\u001b[16GK\u001b[15G:\u001b[14G:\u001b[13Gt\u001b[12Gn\u001b[11Ge\u001b[10Gv\u001b[9Ge\u001b[7Ge\u001b[6Gs\u001b[5Gu\u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m4\u001b[2G \u001b[1G \u001b[6;31H\u001b[38;2;51;51;51m \u001b[30G \u001b[29G \u001b[28G;\u001b[27Gy\u001b[26Ge\u001b[25Gk\u001b[24G:\u001b[23G:\u001b[22Gs\u001b[21Go\u001b[20Gr\u001b[19Gc\u001b[18Ga\u001b[17Gm\u001b[16G_\u001b[15Gc\u001b[13Gr\u001b[12Gp\u001b[11G_\u001b[10Gy\u001b[9Gm\u001b[7Ge\u001b[6Gs\u001b[5Gu\u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m5\u001b[2G \u001b[1G \u001b[7;22H\u001b[38;2;51;51;51m \u001b[21G \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[9G \u001b[7G \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m6\u001b[2G \u001b[1G \u001b[8;47H\u001b[38;2;51;51;51m[\u001b[45G=\u001b[43G]\u001b[42G3\u001b[40G;\u001b[39G]\u001b[38G0\u001b[37G1\u001b[35G;\u001b[34Gr\u001b[33Ga\u001b[32Gh\u001b[31Gc\u001b[30G[\u001b[29G[\u001b[28G \u001b[27G:\u001b[26GE\u001b[25GR\u001b[24GO\u001b[23GC\u001b[22GS\u001b[21G_\u001b[20GP\u001b[19GA\u001b[18GM\u