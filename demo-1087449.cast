u001b[15G \u001b[14G \u001b[13G \u001b[12G \u001b[11G \u001b[10G \u001b[9G(\u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m9\u001b[2G7\u001b[5;24H\u001b[38;2;51;51;51m,\u001b[23G\u001b[38;2;163;21;21m\"\u001b[22GU\u001b[21GI\u001b[20G-\u001b[19GK\u001b[18GA\u001b[17GR\u001b[16GO\u001b[15GV\u001b[14GD\u001b[13G\"\u001b[12G\u001b[38;2;51;51;51m \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m0\u001b[2G8\u001b[6;41H\u001b[38;2;51;51;51m \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G\u001b[38;2;0;128;0m.\u001b[30Gd\u001b[29Ge\u001b[28Gp\u001b[27Gp\u001b[26Ga\u001b[25Gw\u001b[24Gs\u001b[23G \u001b[22GU\u001b[21G \u001b[20Gd\u001b[19Gn\u001b[18Ga\u001b[17G \u001b[16GI\u001b[15G \u001b[14G/\u001b[13G/\u001b[12G\u001b[38;2;51;51;51m \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m1\u001b[2G8\u001b[7;105H\u001b[38;2;0;128;0m/\u001b[104Gi\u001b[103G_\u001b[102Gh\u001b[101Gt\u001b[100Gi\u001b[99Gw\u001b[98G_\u001b[97Gu\u001b[96G_\u001b[95Gg\u001b[94Gn\u001b[93Gi\u001b[92Gp\u001b[91Gp\u001b[90Ga\u001b[89Gw\u001b[88Gs\u001b[87G_\u001b[86Gd\u001b[85Ge\u001b[84Gi\u001b[83Gr\u001b[82Gt\u001b[81G_\u001b[80Ge\u001b[79Gn\u001b[78Go\u001b[77Gy\u001b[76Gn\u001b[75Ga\u001b[74G_\u001b[73Ge\u001b[72Gv\u001b[71Ga\u001b[70Gh\u001b[69G/\u001b[68Gr\u001b[67G3\u001b[66G5\u001b[65Gz\u001b[64Gf\u001b[63Gt\u001b[62G/\u001b[61Gs\u001b[60Gt\u001b[59Gn\u001b[58Ge\u001b[57Gm\u001b[56Gm\u001b[55Go\u001b[54Gc\u001b[53G/\u001b[52Gk\u001b[51Ga\u001b[50Gr\u001b[49Go\u001b[48Gv\u001b[47Gd\u001b[46G/\u001b[45Gr\u001b[44G/\u001b[43Gm\u001b[42Go\u001b[41Gc\u001b[40G.\u001b[39Gt\u001b[38Gi\u001b[37Gd\u001b[36Gd\u001b[35Ge\u001b[34Gr\u001b[33G.\u001b[32Gw\u001b[31Gw\u001b[30Gw\u001b[29G/\u001b[28G/\u001b[27G:\u001b[26Gs\u001b[25Gp\u001b[24Gt\u001b[23Gt\u001b[22Gh\u001b[21G \u001b[20Gr\u001b[19Ge\u001b[18Gf\u001b[17Ge\u001b[16GR\u001b[15G \u001b[14G/\u001b[13G/\u001b[12G\u001b[38;2;51;51;51m \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m2\u001b[2G8\u001b[8;27H\u001b[38;2;51;51;51m \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[16G \u001b[15G \u001b[14G \u001b[13G[\u001b[12G \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m3\u001b[2G8\u001b[9;68H\u001b[38;2;51;51;51m,\u001b[67G]\u001b[66G'\u001b[65Gl\u001b[64G'\u001b[62G,\u001b[61G'\u001b[60Gr\u001b[59G'\u001b[57G,\u001b[56G'\u001b[55Gc\u001b[54G'\u001b[52G,\u001b[51G'\u001b[50Gg\u001b[49G'\u001b[47G,\u001b[46G'\u001b[45Gf\u001b[44G'\u001b[43G \u001b[42G,\u001b[41G'\u001b[40Gy\u001b[39G'\u001b[38G \u001b[37G,\u001b[36G'\u001b[35Gp\u001b[34G'\u001b[33G \u001b[32G,\u001b[31G'\u001b[30G.\u001b[29G'\u001b[28G \u001b[27G,\u001b[26G'\u001b[25G,\u001b[24G'\u001b[23G \u001b[22G,\u001b[21G'\u001b[20G'\u001b[19G\\\u001b[18G'\u001b[17G[\u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[12G \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m4\u001b[2G8\u001b[10;67H\u001b[38;2;51;51;51m,\u001b[66G]\u001b[65G'\u001b[64Gs\u001b[63G'\u001b[61G,\u001b[60G'\u001b[59Gn\u001b[58G'\u001b[56G,\u001b[55G'\u001b[54Gt\u001b[53G'\u001b[51G,"]
[244.088021, "o", "\u001b[50G'\u001b[49Gh\u001b[48G'\u001b[46G,\u001b[45G'\u001b[44Gd\u001b[43G'\u001b[41G,\u001b[40G'\u001b[39Gu\u001b[38G'\u001b[36G,\u001b[35G'\u001b[34Gi\u001b[33G'\u001b[31G,\u001b[30G'\u001b[29Ge\u001b[28G'\u001b[26G,\u001b[25G'\u001b[24Go\u001b[23G'\u001b[22G \u001b[21G,\u001b[20G'\u001b[19Ga\u001b[18G'\u001b[17G[\u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[12G \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m5\u001b[2G8\u001b[11;67H\u001b[38;2;51;51;51m,\u001b[66G]\u001b[65G'\u001b[64Gz\u001b[63G'\u001b[61G,\u001b[60G'\u001b[59Gv\u001b[58G'\u001b[56G,\u001b[55G'\u001b[54Gw\u001b[53G'\u001b[51G,\u001b[50G'\u001b[49Gm\u001b[48G'\u001b[46G,\u001b[45G'\u001b[44Gb\u001b[43G'\u001b[42G \u001b[41G,\u001b[40G'\u001b[39Gx\u001b[38G'\u001b[37G \u001b[36G,\u001b[35G'\u001b[34Gk\u001b[33G'\u001b[32G \u001b[31G,\u001b[30G'\u001b[29Gj\u001b[28G'\u001b[27G \u001b[26G,\u001b[25G'\u001b[24Gq\u001b[23G'\u001b[22G \u001b[21G,\u001b[20G'\u001b[19G;\u001b[18G'\u001b[17G[\u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[12G \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m6\u001b[2G8\u001b[12;27H\u001b[38;2;51;51;51m \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[16G \u001b[15G \u001b[14G,\u001b[13G]\u001b[12G \u001b[11G \u001b[10G \u001b[9G \u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m7\u001b[2G8\u001b[13;30H\u001b[38;2;51;51;51m \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[12G \u001b[11G \u001b[10G,\u001b[9G)\u001b[7G \u001b[6G \u001b[5G \u001b[3G\u001b[38;2;106;153;85m8\u001b[2G8\u001b[14;9H\u001b[38;2;51;51;51m(\u001b[3G\u001b[38;2;106;153;85m9\u001b[2G8\u001b[15;37H\u001b[38;2;51;51;51m \u001b[36G \u001b[35G \u001b[34G \u001b[32G \u