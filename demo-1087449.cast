[25.407182, "o", "\u001b[?25l\u001b[2;39H\u001b[21m\u001b[59m\u001b[24m\u001b[48;2;255;255;255m\u001b[38;2;55;59;65m \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[16G \u001b[15G \u001b[14G \u001b[13G \u001b[12G \u001b[11G \u001b[10G}\u001b[9G \u001b[8G \u001b[7G \u001b[6G \u001b[4G\u001b[38;2;180;183;180m5\u001b[3G2\u001b[3;41H\u001b[38;2;55;59;65m \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[16G \u001b[15G \u001b[13G \u001b[12G \u001b[11G \u001b[10G \u001b[8G \u001b[7G \u001b[6G \u001b[4G\u001b[38;2;180;183;180m6\u001b[3G2\u001b[4;49H\u001b[38;2;55;59;65m \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G{\u001b[38G \u001b[37G\u001b[38;2;234;183;0ms\u001b[36Ge\u001b[35Gh\u001b[34Gc\u001b[33Gt\u001b[32Ga\u001b[31Gp\u001b[30Gs\u001b[29Gi\u001b[28GD\u001b[27G\u001b[38;2;55;59;65m \u001b[26G>\u001b[25G-\u001b[24G \u001b[23G)\u001b[22G(\u001b[21G\u001b[38;2;66;113;174my\u001b[20Gt\u001b[19Gp\u001b[18Gm\u001b[17Ge\u001b[16G\u001b[38;2;55;59;65m \u001b[15G\u001b[38;2;137;89;168mn\u001b[14Gf\u001b[13G\u001b[38;2;55;59;65m \u001b[12G\u001b[38;2;137;89;168mb\u001b[11Gu\u001b[10Gp\u001b[4G\u001b[38;2;180;183;180m7\u001b[3G2\u001b[5;39H\u001b[38;2;55;59;65m)\u001b[38G)\u001b[37G(\u001b[36G\u001b[38;2;66;113;174mt\u001b[35Gl\u001b[34Gu\u001b[33Ga\u001b[32Gf\u001b[31Ge\u001b[30Gd\u001b[29G\u001b[38;2;55;59;65m:\u001b[28G:\u001b[27G\u001b[38;2;234;183;0mc\u001b[26Ge\u001b[25GV\u001b[24G\u001b[38;2;55;59;65m(\u001b[23G\u001b[38;2;66;113;174ms\u001b[22Ge\u001b[21Gh\u001b[20Gc\u001b[19Gt\u001b[18Ga\u001b[17Gp\u001b[16Gs\u001b[15Gi\u001b