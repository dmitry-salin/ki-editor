[205.964136, "o", "\u001b[?25l\u001b[6;32H\u001b[21m\u001b[59m\u001b[24m\u001b[48;2;255;255;255m\u001b[38;2;51;51;51m \u001b[31G\u001b[38;2;0;128;0m.\u001b[30Gd\u001b[29Ge\u001b[28Gp\u001b[27Gp\u001b[26Ga\u001b[25Gw\u001b[24Gs\u001b[23G \u001b[22GU\u001b[21G \u001b[11G\u001b[38;2;51;51;51m \u001b[7;106H \u001b[28G\u001b[38;2;0;128;0m/\u001b[27G:\u001b[26Gs\u001b[25Gp\u001b[24Gt\u001b[23Gt\u001b[22Gh\u001b[21G \u001b[20Gr\u001b[19Ge\u001b[18Gf\u001b[17Ge\u001b[16GR\u001b[15G \u001b[14G/\u001b[13G/\u001b[12G\u001b[38;2;51;51;51m \u001b[11G \u001b[10G \u001b[9G \u001b[6G \u001b[5G \u001b[8;14H \u001b[9;63H \u001b[58G \u001b[53G \u001b[48G \u001b[43G \u001b[38G \u001b[33G \u001b[28G \u001b[23G \u001b[18G'\u001b[24;17H\u001b[48;2;215;215;215m\u001b[38;2;163;21;21m\"\u001b[16GQ\u001b[15GU\u001b[14GP\u001b[13G\"\u001b[25;104H\u001b[48;2;255;255;255m\u001b[38;2;0;128;0mt\u001b[103Gf\u001b[102Gi\u001b[101Gh\u001b[100GS\u001b[99G-\u001b[98Gn\u001b[97Ge\u001b[96Gm\u001b[95Gu\u001b[94Ga\u001b[93GD\u001b[92Gt\u001b[91Gi\u001b[90GM\u001b[89Gr\u001b[88Gu\u001b[87Gt\u001b[86Ga\u001b[85Gt\u001b[84Gs\u001b[83Ga\u001b[82GT\u001b[81Ge\u001b[80Gd\u001b[79Ga\u001b[78Gr\u001b[77Ge\u001b[76GG\u001b[75Ge\u001b[74Gi\u001b[73GD\u001b[72Gr\u001b[71Gc\u001b[70Gb\u001b[69G%\u001b[68G3\u001b[67Gc\u001b[66G%\u001b[65GF\u001b[64Gg\u001b[63Gn\u001b[62Gu\u001b[61Gr\u001b[60Ge\u001b[59Gi\u001b[58Gm\u001b[57Gi\u001b[56Gt\u001b[55Gp\u001b[54GO\u001b[53G.\u001b[52Gn\u001b[51Gi\u001b[50Ga\u001b[49GM\u001b[48G=\u001b[47Gn\u001b[46G?\u001b[45Gp\u001b[44Gh\u001b[43Gp\u001b[42G.\u001b[40G\u001b[48;2;215;215;215me\u001b[39Gd\u001b[38Gn\u001b[37Gi\u001b[36G/\u001b[35Ge\u001b[34Gd\u001b[33G.\u001b[32Gw\u001b[31Gn\u001b[30Gd\u001b[29Ga\u001b[28G/\u001b[27G/\u001b[26G:\u001b[24Gt\u001b[23Gt\u001b[22Gh\u001b[21G \u001b[20Gr\u001b[19Ge\u001b[18Gf\u001b[17Ge\u001b[16GR\u001b[15G \u001b[14G/\u001b[13G/\u001b[26;13H\u001b[48;2;255;255;255m\u001b[38;2;51;51;51m[\u001b[27;67H,\u001b[66G]\u001b[65G'\u001b[64Gf\u001b[63G'\