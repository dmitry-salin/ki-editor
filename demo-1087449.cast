[214.707821, "o", "\u001b[53G \u001b[52G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G;\u001b[40G}\u001b[39G\u001b[38;2;38;127;153md\u001b[38Gn\u001b[37Ga\u001b[36Gm\u001b[35Gm\u001b[34Go\u001b[33Gc\u001b[32Gb\u001b[31Gu\u001b[30GS\u001b[29G\u001b[38;2;51;51;51m \u001b[28G,\u001b[27G\u001b[38;2;38;127;153mr\u001b[26Ge\u001b[25Gs\u001b[24Gr\u001b[23Ga\u001b[22GP\u001b[21G\u001b[38;2;51;51;51m \u001b[20G,\u001b[19G\u001b[38;2;38;127;153ms\u001b[18Gg\u001b[17Gr\u001b[16GA\u001b[15G\u001b[38;2;51;51;51m{\u001b[14G:\u001b[13G:\u001b[12Gp\u001b[11Ga\u001b[10Gl\u001b[9Gc\u001b[7G\u001b[38;2;175;0;219me\u001b[6Gs\u001b[5Gu\u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m5\u001b[2G \u001b[1G \u001b[7;77H\u001b[38;2;51;51;51m \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[47G \u001b[46G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G;\u001b[28G\u001b[38;2;38;127;153mg\u001b[27Gn\u001b[26Gi\u001b[25Gs\u001b[24Ga\u001b[23GC\u001b[22G\u001b[38;2;51;51;51m:\u001b[21G:\u001b[20Ge\u001b[19Gs\u001b[18Ga\u001b[17Gc\u001b[16G_\u001b[15Gt\u001b[14Gr\u001b[13Ge\u001b[12Gv\u001b[11Gn\u001b[10Go\u001b[9Gc\u001b[7G\u001b[38;2;175;0;219me\u001b[6Gs\u001b[5Gu\u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m6\u001b[2G \u001b[1G \u001b[8;96H\u001b[38;2;51;51;51m \u001b[95G \u001b[94G \u001b[93G \u001b[92G \u001b[91G \u001b[90G \u001b[89G \u001b[88G \u001b[87G \u001b[86G \u001b[85G \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73