[25.407433, "o", "\u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G \u001b[20G \u001b[19G \u001b[18G,\u001b[17G\u001b[38;2;245;135;31mk\u001b[16Gc\u001b[15Ga\u001b[14GB\u001b[13Ge\u001b[12Gn\u001b[11Gi\u001b[10GF\u001b[9G\u001b[38;2;55;59;65m \u001b[8G \u001b[7G \u001b[6G \u001b[4G\u001b[38;2;180;183;180m9\u001b[3G3\u001b[17;51H\u001b[38;2;150;152;150m \u001b[50G)\u001b[49Ge\u001b[48Gn\u001b[47Gi\u001b[46Gf\u001b[45G(\u001b[44G \u001b[43Ge\u001b[42Gl\u001b[41Gi\u001b[40Gf\u001b[39G \u001b[38Ga\u001b[37G \u001b[36Gn\u001b[35Gi\u001b[34Gh\u001b[33Gt\u001b[32Gi\u001b[31Gw\u001b[30G \u001b[29Gd\u001b[28Gr\u001b[27Ga\u001b[26Gw\u001b[25Gr\u001b[24Go\u001b[23Gf\u001b[22G \u001b[21Ge\u001b[20Gt\u001b[19Ga\u001b[18Gg\u001b[17Gi\u001b[16Gv\u001b[15Ga\u001b[14GN\u001b[13G \u001b[12G/\u001b[11G/\u001b[10G/\u001b[9G\u001b[38;2;55;59;65m \u001b[8G \u001b[7G \u001b[6G \u001b[4G\u001b[38;2;180;183;180m0\u001b[3G4\u001b[2G8\u001b[1G3\u001b[18;40H\u001b[38;2;55;59;65m \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G,\u001b[20G\u001b[38;2;245;135;31md\u001b[19Gr\u001b[18Ga\u001b[17Gw\u001b[16Gr\u001b[15Go\u001b[14GF\u001b[13Ge\u001b[12Gn\u001b[11Gi\u001b[10GF\u001b[4G\u001b[38;2;180;183;180m1\u001b[19;82H\u001b[38;2;55;59;65m \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G \u001b[71G \u