[253.682286, "o", "\u001b[25G≡\u001b[24G\"\u001b[22G\u001b[38;2;51;51;51m:\u001b[21G\u001b[38;2;0;16;128me\u001b[20Gm\u001b[19Ga\u001b[18Gn\u001b[17G\u001b[38;2;51;51;51m \u001b[5G\u001b[38;2;170;170;170m│\u001b[4G\u001b[38;2;106;153;85m1\u001b[3G4\u001b[2G3\u001b[1G1\u001b[11;74H\u001b[38;2;51;51;51m \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[53G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G{\u001b[44G \u001b[43G\u001b[38;2;38;127;153mg\u001b[42Gi\u001b[41Gf\u001b[40Gn\u001b[39Go\u001b[38GC\u001b[37Gd\u001b[36Gn\u001b[35Ge\u001b[34Gg\u001b[33Ge\u001b[32GL\u001b[31Gp\u001b[30Ga\u001b[29Gm\u001b[28Gy\u001b[27Ge\u001b[26GK\u001b[25G\u001b[38;2;51;51;51m \u001b[24G:\u001b[23G\u001b[38;2;0;16;128mg\u001b[22Gi\u001b[21Gf\u001b[20Gn\u001b[19Go\u001b[18Gc\u001b[17G\u001b[38;2;51;51;51m \u001b[5G\u001b[38;2;170;170;170m│\u001b[4G\u001b[38;2;106;153;85m2\u001b[3G4\u001b[2G3\u001b[1G1\u001b[12;66H\u001b[38;2;51;51;51m \u001b[65G \u001b[64G \u001b[63G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G,\u001b[53G)\u001b[52G(\u001b[51G\u001b[38;2;121;94;38mg\u001b[50Gn\u001b[49Gi\u001b[48Gr\u001b[47Gt\u001b[46Gs\u001b[45G_\u001b[44Go\u001b[43Gt\u001b[42G\u001b[38;2;51;51;51m.\u001b[41G\u001b[38;2;163;21;21m\"\u001b[40Go\u001b[39Gd\u001b[38Ge\u001b[37GR\u001b[36G/\u001b[35Go\u001b[34Gd\u001b[33Gn\u001b[32GU\u001b[31G \u001b[30G≡\u001b[29G\"\u001b[28G\u001b[38;2;51;51;51m \u001b[27G:\u001b[26G\u001b[38;2;0;16;128me\u001b[25Gl\u001b[24Gt\u001b[23Gi\u001b[22Gt\u001b[21G\u001b[38;2;51;51;51m \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[5G\u001b[38;2;170;170;170m│\u001b[4G\u001b[38;2;106;153;85m3\u001b[2G3\u001b[1G1\u001b[13;48H\u001b[38;2;51;51;51m,\u001b[47G)\u001b[46G(\u001b[45G\u001b[38;2;121;94;38mp\u001b