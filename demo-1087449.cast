[253.682476, "o", "\u001b[75G\u001b[38;2;51;51;51m(\u001b[74Gr\u001b[73Go\u001b[72Gt\u001b[71Gi\u001b[70Gd\u001b[69GE\u001b[68Go\u001b[67GT\u001b[66G:\u001b[65G:\u001b[64G\u001b[38;2;38;127;153mh\u001b[63Gc\u001b[62Gt\u001b[61Ga\u001b[60Gp\u001b[59Gs\u001b[58Gi\u001b[57GD\u001b[56G\u001b[38;2;51;51;51m \u001b[55G,\u001b[54G\u001b[38;2;163;21;21m\"\u001b[53Go\u001b[52Gd\u001b[51Gn\u001b[50GU\u001b[49G \u001b[48Ge\u001b[47Gs\u001b[46Gr\u001b[45Ga\u001b[44Go\u001b[43GC\u001b[42G\"\u001b[41G\u001b[38;2;51;51;51m(\u001b[40G\u001b[38;2;121;94;38mw\u001b[39Ge\u001b[38Gn\u001b[37G\u001b[38;2;51;51;51m:\u001b[36G:\u001b[35G\u001b[38;2;38;127;153mp\u001b[34Ga\u001b[33GT\u001b[31GO\u001b[30G\u001b[38;2;51;51;51m(\u001b[29Ge\u001b[28Gm\u001b[27Go\u001b[26GS\u001b[25G \u001b[24G:\u001b[23G\u001b[38;2;0;16;128mp\u001b[22Ga\u001b[21Gt\u001b[20G_\u001b[19Gn\u001b[18Go\u001b[17G\u001b[38;2;51;51;51m \u001b[5G\u001b[38;2;170;170;170m│\u001b[4G\u001b[38;2;106;153;85m6\u001b[3G4\u001b[2G3\u001b[1G1\u001b[16;41H\u001b[38;2;51;51;51m \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G \u001b[20G \u001b[19G \u001b[18G \u001b[17G \u001b[16G,\u001b[15G)\u001b[14G}\u001b[13G \u001b[12G \u001b[11G \u001b[10G \u001b[9G \u001b[8G \u001b[7G \u001b[6G \u001b[5G\u001b[38;2;170;170;170m│\u001b[4G\u001b[38;2;106;153;85m7\u001b[3G4\u001b[2G3\u001b[1G1\u001b[17;86H\u001b[48;2;128;128;128m\u001b[38;2;255;255;255m \u001b[85G\u001b[48;2;173;214;255m\u001b[38;2;51;51;51m,\u001b[84G)\u001b[83Ge\u001b[82Gl\u001b[81Gi\u001b[80GF\u001b[79Ge\u001b[78Gv\u001b[77Ga\u001b[76GS\u001b[75G:\u001b[74G:\u001b[73G\u001b[38;2;38;127;153mh\u001b[72Gc\u001b[71Gt\u001b[70Ga\u001b[69Gp\u001b[68Gs\u001b[67Gi\u001b[66GD\u001b[65G\u001b[38;2;51;51;51m \u001b[64G,\u001b[63G\u001b[38;2;163;21;21m\"\u001b[62Ge\u001b[61Gv\u001b[60Ga\u001b[59GS\u001b[58G\"\u001b[57G\