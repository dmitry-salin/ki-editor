[253.752087, "o", "\u001b[2G9\u001b[1G \u001b[23;15H\u001b[38;2;51;51;51m \u001b[14G \u001b[9G(\u001b[5G \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m8\u001b[2G9\u001b[1G \u001b[24;91H\u001b[38;2;51;51;51m \u001b[90G \u001b[89G \u001b[88G \u001b[87G \u001b[86G \u001b[85G \u001b[84G \u001b[83G \u001b[82G \u001b[81G \u001b[80G \u001b[79G \u001b[78G \u001b[77G \u001b[76G \u001b[75G \u001b[74G \u001b[73G \u001b[72G \u001b[71G \u001b[70G \u001b[69G \u001b[68G \u001b[67G \u001b[66G \u001b[65G \u001b[64G \u001b[62G \u001b[61G \u001b[60G \u001b[59G \u001b[58G \u001b[57G \u001b[56G \u001b[55G \u001b[54G \u001b[52G \u001b[51G \u001b[50G \u001b[49G \u001b[48G \u001b[47G \u001b[46G \u001b[45G \u001b[44G \u001b[43G \u001b[42G \u001b[41G \u001b[40G \u001b[39G \u001b[38G \u001b[37G \u001b[36G \u001b[35G \u001b[34G \u001b[33G \u001b[32G \u001b[31G \u001b[30G \u001b[29G \u001b[28G \u001b[27G \u001b[26G \u001b[25G \u001b[24G \u001b[23G \u001b[22G \u001b[21G \u001b[20G \u001b[19G \u001b[18G,\u001b[17G\u001b[38;2;163;21;21m\"\u001b[16GQ\u001b[15GU\u001b[14GP\u001b[13G\"\u001b[5G\u001b[38;2;51;51;51m \u001b[4G\u001b[38;2;170;170;170m│\u001b[3G\u001b[38;2;106;153;85m9\u001b[2G9\u001b[1G \u001b[25;104H\u001b[38;2;0;128;0mt\u001b[103Gf\u001b[102Gi\u001b[101Gh\u001b[100GS\u001b[99G-\u001b[98Gn\u001b[97Ge\u001b[96Gm\u001b[95Gu\u001b[94Ga\u001b[93GD\u001b[92Gt\u001b[91Gi\u001b[90GM\u001b[89Gr\u001b[88Gu\u001b[87Gt\u001b[86Ga\u001b[85Gt\u001b[84Gs\u001b[83Ga\u001b[82GT\u001b[81Ge\u001b[80Gd\u001b[79Ga\u001b[78Gr\u001b[77Ge\u001b[76GG\u001b[75Ge\u001b[74Gi\u001b[73GD\u001b[72Gr\u001b[71Gc\u001b[70Gb\u001b[69G%\u001b[68G3\u001b[67Gc\u001b[66G%\u001b[65GF\u001b[64Gg\u001b[63Gn\u001b[62Gu\u001b[61Gr\u001b[60Ge\u001b[59Gi\u001b[58Gm\u001b[57Gi\u001b[56Gt\u001b[55Gp\u001b[54GO\u001b[53G.\u001b[52Gn\u001b[51Gi\u001b[50Ga\u001b[49GM\u001b[48G=\u001b[47Gn\u001b[46G?\u001b[45Gp\u001b[44Gh\u001b[43Gp\u001b[42G.\u001b[41Gx\u001b[40Ge\u001b[39Gd\u001b[38Gn\u001b[37Gi\u001b[36G/\u001b[3